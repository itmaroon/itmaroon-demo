{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "ITmaroon blocks — sample pottery studio site",
    "author": "itmaroon"
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "secure-custom-fields"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "block-collections"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "query-blocks"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "slide-blocks"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "form-send-blocks"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "itmaroon-booking-block"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "opening-block"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "markdown-block"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "itmaroon-ec-relate-blocks"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/itmaroon-demo"
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/mu-plugins"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/itmaroon-demo-setup.php",
      "data": {
        "resource": "url",
        "url": "http://127.0.0.1:8100/mu-plugin/itmaroon-demo-setup.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/itmaroon-demo/seed.json",
      "data": {
        "resource": "url",
        "url": "http://127.0.0.1:8100/seed.json"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/itmaroon-demo/seed.php",
      "data": {
        "resource": "url",
        "url": "http://127.0.0.1:8100/seed.php"
      }
    },
    {
      "step": "unzip",
      "zipFile": {
        "resource": "url",
        "url": "http://127.0.0.1:8100/uploads.zip"
      },
      "extractToPath": "/wordpress/wp-content/uploads"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "http://127.0.0.1:8100/theme/kiln-theme.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-content/itmaroon-demo/seed.php';"
    }
  ]
}